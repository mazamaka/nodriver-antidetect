# nodriver-antidetect configuration
# Copy this file to .env and adjust values

# Fingerprint profile (JSON file path, takes priority over individual settings)
AD_PROFILE_PATH=profiles/mazamaka_local.json

# Timezone & Locale
AD_TIMEZONE=Europe/Berlin
AD_LOCALE=en-US

# Screen resolution
AD_SCREEN_WIDTH=1920
AD_SCREEN_HEIGHT=1080

# Hardware
AD_DEVICE_MEMORY=8
AD_HARDWARE_CONCURRENCY=8
AD_PLATFORM=Linux x86_64

# WebGL GPU spoofing
AD_WEBGL_VENDOR=Google Inc. (NVIDIA Corporation)
AD_WEBGL_RENDERER=ANGLE (NVIDIA Corporation, NVIDIA GeForce RTX 3060/PCIe/SSE2, OpenGL 4.5.0)

# User-Agent (leave empty for auto-detection from installed Chrome)
AD_USER_AGENT=

# Languages
AD_LANGUAGES=en-US,en

# Browser mode (NEVER use true in production - instantly detected!)
AD_HEADLESS=false

# Proxy (optional)
# PROXY_URL=socks5://user:pass@host:port
